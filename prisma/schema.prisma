generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Side {
  BUY
  SELL
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts TradingAccount[]
}

model TradingAccount {
  id            String   @id @default(cuid())
  userId        String
  name          String
  broker        String
  accountType   String
  currency      String
  initialBalance Decimal
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  trades Trade[]
}

model Trade {
  id            String   @id @default(cuid())
  accountId     String
  symbol        String
  side          Side
  entryPrice    Decimal
  exitPrice     Decimal?
  quantity      Decimal
  stopLoss      Decimal?
  takeProfit    Decimal?
  commission    Decimal
  entryTime     DateTime
  exitTime      DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account TradingAccount @relation(fields: [accountId], references: [id])
}